{
  "$defs": {
    "SyncKnowledge": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "action": {
          "enum": [
            "update",
            "revalidate",
            "retire",
            "use-upstream"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "artifacts": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "target",
        "action",
        "reason"
      ],
      "title": "SyncKnowledge",
      "type": "object"
    },
    "SyncResolution": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "action": {
          "enum": [
            "replace",
            "delete",
            "take-file"
          ],
          "title": "Action",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "mode": {
          "default": "100644",
          "enum": [
            "100644",
            "100755"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "action",
        "reason"
      ],
      "title": "SyncResolution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "orchi-sync",
      "default": "orchi-sync",
      "title": "Format",
      "type": "string"
    },
    "based_on": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Based On",
      "type": "string"
    },
    "upstream": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Upstream",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "target_assessment": {
      "minLength": 1,
      "title": "Target Assessment",
      "type": "string"
    },
    "target_revision_required": {
      "default": false,
      "title": "Target Revision Required",
      "type": "boolean"
    },
    "resolutions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SyncResolution"
      },
      "title": "Resolutions",
      "type": "array"
    },
    "knowledge": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SyncKnowledge"
      },
      "title": "Knowledge",
      "type": "array"
    },
    "checks": {
      "default": [],
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "based_on",
    "upstream",
    "reason",
    "target_assessment"
  ],
  "title": "SyncProposal",
  "type": "object"
}
