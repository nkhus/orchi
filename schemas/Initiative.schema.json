{
  "$defs": {
    "IntentRef": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "digest"
      ],
      "title": "IntentRef",
      "type": "object"
    },
    "RoadmapEpic": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "contributes_to": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Contributes To",
          "type": "array"
        },
        "risks": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "realizes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Realizes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "outcome",
        "contributes_to"
      ],
      "title": "RoadmapEpic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "orchi-initiative",
      "default": "orchi-initiative",
      "title": "Format",
      "type": "string"
    },
    "id": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "outcome": {
      "minLength": 1,
      "title": "Outcome",
      "type": "string"
    },
    "result_kind": {
      "default": "software",
      "enum": [
        "software",
        "knowledge",
        "investigation"
      ],
      "title": "Result Kind",
      "type": "string"
    },
    "delivery": {
      "const": "atomic",
      "default": "atomic",
      "title": "Delivery",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/IntentRef"
    },
    "epics": {
      "items": {
        "$ref": "#/$defs/RoadmapEpic"
      },
      "minItems": 1,
      "title": "Epics",
      "type": "array"
    }
  },
  "required": [
    "id",
    "outcome",
    "intent",
    "epics"
  ],
  "title": "Initiative",
  "type": "object"
}
