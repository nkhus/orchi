{
  "$defs": {
    "DesignRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash"
      ],
      "title": "DesignRef",
      "type": "object"
    },
    "Edit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "action": {
          "enum": [
            "create",
            "modify",
            "delete"
          ],
          "title": "Action",
          "type": "string"
        },
        "how": {
          "minLength": 1,
          "title": "How",
          "type": "string"
        }
      },
      "required": [
        "path",
        "action",
        "how"
      ],
      "title": "Edit",
      "type": "object"
    },
    "ScopeRule": {
      "additionalProperties": false,
      "description": "An accepted directory envelope, not a wildcard permission to change semantics.",
      "properties": {
        "directory": {
          "minLength": 1,
          "title": "Directory",
          "type": "string"
        },
        "actions": {
          "items": {
            "enum": [
              "create",
              "modify",
              "delete"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "choices": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "directory",
        "actions",
        "choices"
      ],
      "title": "ScopeRule",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "knowledge",
            "code",
            "dependency"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "view": {
          "anyOf": [
            {
              "enum": [
                "current",
                "target"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View"
        },
        "producer": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        },
        "contract": {
          "default": "",
          "title": "Contract",
          "type": "string"
        },
        "delivery": {
          "default": "inline",
          "enum": [
            "inline",
            "on-demand"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "consistency": {
          "default": "fixed",
          "enum": [
            "fixed",
            "snapshot"
          ],
          "title": "Consistency",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "reason"
      ],
      "title": "Source",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "implementation",
          "enum": [
            "implementation",
            "investigation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "executor": {
          "default": "agent",
          "enum": [
            "agent",
            "human",
            "pair"
          ],
          "title": "Executor",
          "type": "string"
        },
        "write_scope": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScopeRule"
          },
          "title": "Write Scope",
          "type": "array"
        },
        "max_scope_additions": {
          "default": 8,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Scope Additions",
          "type": "integer"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "acceptance": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z0-9]+(?:[-.][a-z0-9]+)*$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 80
          },
          "title": "Acceptance",
          "type": "object"
        },
        "depends_on": {
          "default": [],
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "current_state": {
          "minLength": 1,
          "title": "Current State",
          "type": "string"
        },
        "approach": {
          "minLength": 1,
          "title": "Approach",
          "type": "string"
        },
        "decisions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Decisions",
          "type": "array"
        },
        "invariants": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Invariants",
          "type": "array"
        },
        "allowed_choices": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Choices",
          "type": "array"
        },
        "failure_modes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Failure Modes",
          "type": "array"
        },
        "edits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "title": "Edits",
          "type": "array"
        },
        "context": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Context",
          "type": "array"
        },
        "read_paths": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Read Paths",
          "type": "array"
        },
        "exclusive_resources": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exclusive Resources",
          "type": "array"
        },
        "verification": {
          "items": {
            "$ref": "#/$defs/VerificationCase"
          },
          "minItems": 1,
          "title": "Verification",
          "type": "array"
        },
        "escalation": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Escalation",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "goal",
        "acceptance",
        "current_state",
        "approach",
        "decisions",
        "invariants",
        "allowed_choices",
        "failure_modes",
        "verification",
        "escalation",
        "open_questions"
      ],
      "title": "Task",
      "type": "object"
    },
    "VerificationCase": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
          "title": "Criterion",
          "type": "string"
        },
        "scenario": {
          "minLength": 1,
          "title": "Scenario",
          "type": "string"
        },
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "checks": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "criterion",
        "scenario",
        "expected",
        "checks"
      ],
      "title": "VerificationCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "orchi-epic",
      "default": "orchi-epic",
      "title": "Format",
      "type": "string"
    },
    "initiative_id": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
      "title": "Initiative Id",
      "type": "string"
    },
    "epic_id": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
      "title": "Epic Id",
      "type": "string"
    },
    "based_on": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Based On",
      "type": "string"
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "shared_design": {
      "minLength": 1,
      "title": "Shared Design",
      "type": "string"
    },
    "design": {
      "$ref": "#/$defs/DesignRef"
    },
    "intent_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intent Digest",
      "type": "string"
    },
    "acceptance": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(?:[-.][a-z0-9]+)*$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 80
      },
      "title": "Acceptance",
      "type": "object"
    },
    "acceptance_checks": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(?:[-.][a-z0-9]+)*$": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "propertyNames": {
        "maxLength": 80
      },
      "title": "Acceptance Checks",
      "type": "object"
    },
    "mode": {
      "default": "implementation",
      "enum": [
        "implementation",
        "knowledge-only"
      ],
      "title": "Mode",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "initiative_id",
    "epic_id",
    "based_on",
    "goal",
    "shared_design",
    "design",
    "intent_digest",
    "acceptance",
    "acceptance_checks",
    "tasks"
  ],
  "title": "EpicPlan",
  "type": "object"
}
