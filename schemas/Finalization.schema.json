{
  "$defs": {
    "ArchitectureDisposition": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "realized",
            "deviated",
            "unchanged",
            "not-applicable",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "artifacts": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "core_targets": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Core Targets",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "target",
        "disposition",
        "reason"
      ],
      "title": "ArchitectureDisposition",
      "type": "object"
    },
    "KnowledgeEdit": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "action": {
          "enum": [
            "replace",
            "retire",
            "revalidate"
          ],
          "title": "Action",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "artifacts": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "checks": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target",
        "action",
        "checks",
        "reason"
      ],
      "title": "KnowledgeEdit",
      "type": "object"
    },
    "RequirementDisposition": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "satisfied",
            "changed",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "core_targets": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Core Targets",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "disposition",
        "reason"
      ],
      "title": "RequirementDisposition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "orchi-finalization",
      "default": "orchi-finalization",
      "title": "Format",
      "type": "string"
    },
    "initiative_id": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
      "title": "Initiative Id",
      "type": "string"
    },
    "based_on": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Based On",
      "type": "string"
    },
    "intent_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intent Digest",
      "type": "string"
    },
    "report": {
      "minLength": 1,
      "title": "Report",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/KnowledgeEdit"
      },
      "title": "Entries",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementDisposition"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "architecture": {
      "items": {
        "$ref": "#/$defs/ArchitectureDisposition"
      },
      "minItems": 1,
      "title": "Architecture",
      "type": "array"
    }
  },
  "required": [
    "initiative_id",
    "based_on",
    "intent_digest",
    "report",
    "entries",
    "requirements",
    "architecture"
  ],
  "title": "Finalization",
  "type": "object"
}
